# --- Core ---
# Chat completions (agents/llm.py:get_llm() - planner/responder/argument
# resolver) call OpenAI directly if OPENAI_API_KEY is set (recommended -
# OPENAI_CHAT_MODEL defaults to "gpt-4o-mini", a small/cheap model).
# Without it, falls back to OpenRouter (OPENROUTER_API +
# OPENROUTER_DEFAULT_MODEL) instead - the code's own fallback default model
# ("google/gemini-2-flash") is NOT confirmed to be a valid OpenRouter slug,
# set OPENROUTER_DEFAULT_MODEL explicitly (check https://openrouter.ai/models)
# if you rely on that path, or calls will fail with "invalid model ID".
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=
OPENROUTER_API=
OPENROUTER_DEFAULT_MODEL=
MONGO_URI=mongodb://localhost:27017
DB_NAME=mcp_orchestration
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Where to send the browser back to after a round-trip through a third
# party (currently: Google's Gmail OAuth consent screen).
FRONTEND_URL=http://localhost:5173

# --- Gmail OAuth / Gmail MCP server ---
# Required to enable the bundled Gmail MCP server (mcp/gmail_mcp_server.py).
# Get these from a Google Cloud OAuth 2.0 Client ID (Web application type).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/gmail/callback

# Symmetric key used to encrypt Gmail tokens before storing them in the
# `gmail_credentials` MongoDB collection (see core/token_encryption.py).
# Required for the Gmail MCP server to be enabled. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# --- Long-term memory (agents/memory.py: mem0 + Qdrant) ---
# Qdrant runs via docker-compose (see docker-compose.yaml); defaults below
# match that. Reuses OPENAI_API_KEY/OPENROUTER_API from --- Core --- above
# for its own extraction LLM (same OpenAI-preferred, OpenRouter-fallback
# pattern). The embedder specifically needs OPENAI_API_KEY though - if it
# falls back to OpenRouter, that's NOT verified to work (OpenRouter has
# historically only proxied /chat/completions, not /embeddings); if
# long-term memory silently does nothing, or you see "invalid model ID"
# from the embedder specifically (not the planner's own LLM call), that's
# why. Without either OPENAI_API_KEY or OPENROUTER_API set, long-term
# memory is disabled entirely.
QDRANT_HOST=localhost
QDRANT_PORT=6333
OPENAI_EMBED_MODEL=text-embedding-3-small

# --- MCP ---
# Optional: path to a JSON file of {name, command, args, env} objects to
# add/override MCP server connections beyond the built-in demo + gmail
# servers. See mcp/config.py.
MCP_SERVERS_CONFIG=

# --- Observability / Evals (LangSmith, optional) ---
# Setting these two enables automatic tracing of every planner/tool/
# responder step (langchain_core reads them directly - no code change
# needed). LANGSMITH_PROJECT is optional; a default project is created on
# first trace if unset. Get a key at https://smith.langchain.com.
# See evals/run_evals.py (run via `uv run --group evals`, not `pytest`).
#
# LANGSMITH_ENDPOINT matters if your workspace isn't on the default US
# region - LangSmith also has EU (https://eu.api.smith.langchain.com) and
# APAC (https://apac.api.smith.langchain.com) regions. A key from a
# non-default-region workspace fails with a generic 401 "Invalid token"
# against the default endpoint - that error gives no hint it's a region
# mismatch, so check your workspace settings for the right API URL if you
# hit that. Uncomment/set the line below to match.
# LANGSMITH_ENDPOINT=https://apac.api.smith.langchain.com
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=mcp-orchestration

# --- Vestigial / not currently read by src/ (present in some local .env
#     files from earlier experiments; firecrawl-py and a second Mongo
#     connection aren't wired into any route or MCP server today) ---
# Leave these unset unless you're adding a feature that needs them.
MOVIE_MONGO_URI=
MOVIE_DB_NAME=
FIRECRAWL_API_KEY=
GMAIL_TOKEN_DIR=

# --- Optional: Gmail MCP server tuning ---
# Space or comma-separated Gmail API scopes to request during OAuth.
# Defaults to gmail.readonly + gmail.compose (see CLAUDE.md's Gmail
# integration section) if unset.
GMAIL_SCOPES=
# Google OAuth "access_type" param - "offline" (default, needed to get a
# refresh token) or "online".
GMAIL_ACCESS_TYPE=offline
